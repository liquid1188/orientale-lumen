<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  {% if site.setupMode %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="icon" href="/images/olf-mark.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,500;0,600;1,400&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v={{ buildId }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.tagline }}">
  <meta property="og:image" content="{{ site.url }}/images/pope-francis-2016.jpg">
</head>
<body{% if page.url == "/" %} class="home"{% endif %}>
<a class="skip" href="#main">Skip to content</a>
<header class="site-head">
  <div class="wrap bar">
    <a class="brand" href="/"><img src="/images/olf-mark.png" alt="" width="387" height="450"><span><b>Orientale Lumen</b>Foundation</span></a>
    <input type="checkbox" id="menu" class="menu-toggle" aria-label="Open menu">
    <label for="menu" class="menu-btn"><span></span><span></span></label>
    <nav class="nav" aria-label="Main">
      <a href="/conferences/"{% if page.url == '/conferences/' %} aria-current="page"{% endif %}>Conferences</a>
      <a href="/pilgrimages/"{% if page.url == '/pilgrimages/' %} aria-current="page"{% endif %}>Pilgrimages</a>
      <a href="/oltv/"{% if page.url == '/oltv/' %} aria-current="page"{% endif %}>OLTV</a>
      <a href="/publications/"{% if page.url == '/publications/' %} aria-current="page"{% endif %}>Publications</a>
      <a href="/about/"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
      <a href="{{ site.store }}">Store</a>
      <a class="btn small" href="/give/">Give</a>
    </nav>
  </div>
</header>
<main id="main">{{ content | safe }}</main>
<footer class="site-foot">
  <div class="wrap foot-grid">
    <div>
      <p class="foot-brand">Orientale Lumen Foundation</p>
      <p class="foot-tag">A grass-roots ecumenical movement of lay people and clergy, founded in Washington, DC, in 1997. Recognized by the Ecumenical Patriarch and the Holy See.</p>
      <p class="foot-tag">{{ site.address }} · <a href="tel:7036918862" style="display:inline">{{ site.phone }}</a></p>
    </div>
    <div>
      <h3>Foundation</h3>
      <a href="/conferences/">Conferences</a>
      <a href="/pilgrimages/">Pilgrimages</a>
      <a href="/oltv/">OLTV</a>
      <a href="{{ site.store }}">Recordings and store</a>
    </div>
    <div>
      <h3>Family</h3>
      <a href="/publications/">Eastern Christian Publications</a>
      <a href="/society/">Society of St. John Chrysostom</a>
      <a href="/about/">Jack Figel</a>
      <a href="/press/">Recognition and press</a>
    </div>
    <div>
      <h3>Connect</h3>
      <a href="/give/">Give</a>
      <a href="/contact/">Contact</a>
      <a href="{{ site.youtube }}">YouTube</a>
    </div>
  </div>
  <div class="wrap foot-small">
    <span>&copy; {{ today | year }} Orientale Lumen Foundation. A 501(c)(3) nonprofit.</span>
    <span><a href="/admin/">Sign in</a> · Site by <a href="https://lickitysplitweb.com">Lickity Split Web Design</a></span>
  </div>
</footer>
</body>
</html>
