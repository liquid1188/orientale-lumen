<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  {% if site.setupMode %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="icon" href="/images/olf-mark.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,500;0,600;1,400&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v={{ buildId }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.tagline }}">
  <meta property="og:image" content="{{ site.url }}/images/pope-francis-2016.jpg">
</head>
<body{% if page.url == "/" %} class="home"{% endif %}>
<a class="skip" href="#main">Skip to content</a>
<header class="site-head">
  <div class="wrap bar">
    <a class="brand" href="/"><img src="/images/olf-mark.png" alt="" width="387" height="450"><span><b>Orientale Lumen</b>Foundation</span></a>
    <input type="checkbox" id="menu" class="menu-toggle" aria-label="Open menu">
    <label for="menu" class="menu-btn"><span></span><span></span></label>
    <nav class="nav" aria-label="Main">
      <a href="/conferences/"{% if page.url == '/conferences/' %} aria-current="page"{% endif %}>Conferences</a>
      <a href="/pilgrimages/"{% if page.url == '/pilgrimages/' %} aria-current="page"{% endif %}>Pilgrimages</a>
      <a href="/oltv/"{% if page.url == '/oltv/' %} aria-current="page"{% endif %}>OLTV</a>
      <a href="/gallery/"{% if page.url == '/gallery/' %} aria-current="page"{% endif %}>Gallery</a>
      <a href="/publications/"{% if page.url == '/publications/' %} aria-current="page"{% endif %}>Publications</a>
      <a href="/about/"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
      <a href="{{ site.store }}">Store</a>
      <a class="btn small" href="/give/">Give</a>
    </nav>
  </div>
</header>
<main id="main">{{ content | safe }}</main>
<footer class="site-foot v2">
  <div class="wrap foot-top">
    <div class="fbrand">
      <img class="fmark" src="/images/olf-mark.png" alt="" width="64" height="64" loading="lazy"><p class="foot-brand">Orientale Lumen Foundation</p>
      
      <p class="foot-tag">A grass-roots ecumenical movement of lay people and clergy, founded in Washington, DC, in 1997. Recognized by the Ecumenical Patriarch and the Holy See.</p>
      <div class="foot-ctas"><a class="btn" href="/give/">Give</a><a class="btn ghost" href="/orientale-lumen-xxxi/">Orientale Lumen XXXI</a></div>
    </div>
    <div class="fcol"><h3>Foundation</h3><a href="/conferences/">Conferences</a><a href="/orientale-lumen-xxxi/">Orientale Lumen XXXI</a><a href="/pilgrimages/">Pilgrimages</a><a href="/oltv/">OLTV</a><a href="/gallery/">Gallery</a><a href="{{ site.store }}">Recordings and store</a></div><div class="fcol"><h3>Family</h3><a href="/publications/">Eastern Christian Publications</a><a href="/society/">Society of St. John Chrysostom</a><a href="/about/">Jack Figel</a><a href="/press/">Recognition and press</a></div>
    <div class="fcol fcontact">
      <h3>Contact</h3>
      <a class="crow" href="mailto:{{ site.email }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" d="M3 6h18v12H3z"/><path fill="none" stroke="currentColor" stroke-width="1.7" d="m3 7 9 6 9-6"/></svg><span>{{ site.email }}</span></a><a class="crow" href="tel:7036918862"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" d="M6 3h4l2 5-2.5 1.5a11 11 0 0 0 5 5L16 12l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2z"/></svg><span>{{ site.phone }}</span></a><span class="crow"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.7"/></svg><span>{{ site.address }}</span></span><a class="crow" href="{{ site.youtube }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" d="M3 8.5C3 6.6 4.5 5 6.4 5h11.2C19.5 5 21 6.6 21 8.5v7c0 1.9-1.5 3.5-3.4 3.5H6.4C4.5 19 3 17.4 3 15.5z"/><path fill="currentColor" d="m10 9 5 3-5 3z"/></svg><span>OLTV on YouTube</span></a>
      
    </div>
  </div>
  
  <div class="wrap foot-bottom">
    <span class="copy">&copy; {{ today | year }} Orientale Lumen Foundation. A 501(c)(3) nonprofit.</span>
    <span class="util"><a href="/contact/">Contact</a><a href="/admin/">Sign in</a><a href="https://lickitysplitweb.com">Site by Lickity Split Web Design</a><a class="totop" href="#top" onclick="window.scrollTo({top:0,behavior:'smooth'});return false" aria-label="Back to top"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="m6 14 6-6 6 6"/></svg></a></span>
  </div>
</footer>
</body>
</html>
